{
  "name": "kanbanboard",
  "version": "0.1.0",
  "description": "Phone-friendly kanban board where Claude agents work, test and review your tickets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "AGENT_MODE=mock node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "express": "^4.21.2"
  }
}
