# Copy to .env and fill in. Never commit the real file.

# --- required -------------------------------------------------------------
# One shared password for the board. Agents can run commands on this machine,
# so the server refuses to start without it. Use a long random one.
APP_PASSWORD=change-me-to-something-long

# --- connect Claude -------------------------------------------------------
# API mode. Or set AGENT_MODE=subscription to use your own local Claude Code login (see README).
# AGENT_MODE=subscription
ANTHROPIC_API_KEY=

# --- the code the agents work on -----------------------------------------
# Either clone a repo...
WORKSPACE_REPO=
# ...with a token for private repos (contents: read+write). Only the server uses it, agents never see it.
GIT_TOKEN=
# ...and push each ticket branch to origin so you can open PRs from your phone.
PUSH_BRANCHES=false
# Or point at a repo that already exists on this machine instead of cloning.
WORKSPACE_DIR=
# Branch tickets start from. Defaults to the repo's current branch.
BASE_BRANCH=

# --- cost and safety limits ----------------------------------------------
# per run
AGENT_MAX_BUDGET_USD=2
# whole board, 0 = no limit
DAILY_BUDGET_USD=20
# per run
AGENT_MAX_TURNS=40
# times a ticket may be sent back before it waits for you
MAX_LOOPS=3
MAX_CONCURRENT_AGENTS=2
# false: an approved ticket waits in Review until you mark it done
AUTO_DONE=true
# empty = SDK default
AGENT_MODEL=
# extra env var names agents may see, e.g. NPM_TOKEN
AGENT_ENV_PASSTHROUGH=

# --- server ---------------------------------------------------------------
PORT=3000
DATA_DIR=./data
# Behind a reverse proxy / platform router (Fly, Railway, Render...): set to 1
TRUST_PROXY=
